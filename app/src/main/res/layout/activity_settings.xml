<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/edittext_bg"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agent 设置"
            android:textSize="20sp"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- API Key -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="API KEY"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:paddingBottom="6dp" />
    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sk-..."
        android:textColorHint="@color/text_muted"
        android:inputType="textPassword"
        android:singleLine="true"
        android:background="@drawable/edittext_bg"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="@color/text_primary" />

    <!-- Model -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MODEL"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:paddingTop="20dp"
        android:paddingBottom="6dp" />
    <EditText
        android:id="@+id/etModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="deepseek-chat"
        android:textColorHint="@color/text_muted"
        android:singleLine="true"
        android:background="@drawable/edittext_bg"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="@color/text_primary" />

    <!-- Base URL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BASE URL"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:paddingTop="20dp"
        android:paddingBottom="6dp" />
    <EditText
        android:id="@+id/etBaseUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://api.deepseek.com"
        android:textColorHint="@color/text_muted"
        android:singleLine="true"
        android:background="@drawable/edittext_bg"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="@color/text_primary" />

    <!-- Evolution toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/edittext_bg"
        android:padding="14dp"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EVOLUTION"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />
        <Switch
            android:id="@+id/swEvolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Config path -->
    <TextView
        android:id="@+id/tvConfigPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/text_muted"
        android:fontFamily="monospace"
        android:paddingTop="16dp" />

    <!-- Save button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="保存设置"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:letterSpacing="0.05"
        android:backgroundTint="@color/accent_cyan"
        android:textColor="@color/bg_primary"
        android:layout_marginTop="24dp" />
</LinearLayout>
